{
  "name": "maxweb",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "mkdir -p public && unzip -o MAXWEB.zip 'index.html' 'css/*' 'js/script.js' 'images/*' -d public && mv public/index.html public/site-source.html",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "cf:build": "npm run prebuild && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "jose": "5.10.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3",
    "wrangler": "^4.28.0"
  }
}
