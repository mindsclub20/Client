# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional alias used by some client helpers
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Server-only — required for Authgear admin/client AI & admin chat reads
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (server-only — never NEXT_PUBLIC_) ────────────────────────
MAXWEB_AI_API_KEY2=
# Optional model override; default is gemini-3.8-flash
MAXWEB_GEMINI_MODEL=

# ── Authgear ────────────────────────────────────────────────────────────────
AUTHGEAR_CLIENT_ID=
# Random string, at least 32 characters
AUTHGEAR_SESSION_SECRET=
# Comma-separated admin emails (must be verified in Authgear)
AUTHGEAR_ADMIN_EMAILS=bvshyam7777@gmail.com,saicharan8825@gmail.com
# Must match Authgear Portal redirect URI (Cloudflare hostname)
AUTHGEAR_REDIRECT_URI=https://YOUR_CLOUDFLARE_DOMAIN/authgear/callback
AUTHGEAR_POST_LOGOUT_REDIRECT_URI=https://YOUR_CLOUDFLARE_DOMAIN/
# Optional; defaults to https://lyrics-6xahba.authgear.cloud
AUTHGEAR_ISSUER=https://lyrics-6xahba.authgear.cloud

# ── Optional cron (Workers Cron Triggers) ───────────────────────────────────
CRON_SECRET=
